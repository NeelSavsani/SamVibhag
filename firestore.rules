rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember() {
      return signedIn() &&
        (request.auth.uid in resource.data.get('memberUids', []) ||
         resource.data.get('createdBy', '') == request.auth.uid);
    }

    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.resource.data.get('createdBy', '') == request.auth.uid &&
        request.auth.uid in request.resource.data.get('memberUids', []);
      allow read: if isGroupMember();
      allow update: if isGroupMember() &&
        request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIdentities']) ||
         resource.data.get('createdBy', '') == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['recordedSettlements']);
      // Deletion must go through the creator-checked callable, which also removes
      // the group's activity subcollection. Callable Admin SDK writes bypass rules.
      allow delete: if false;

      match /activities/{activityId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isParentMember() {
          return signedIn() &&
            (request.auth.uid in parentGroup().get('memberUids', []) ||
             parentGroup().get('createdBy', '') == request.auth.uid);
        }
        allow read, create: if isParentMember();
        allow update, delete: if false;
      }
    }
  }
}
